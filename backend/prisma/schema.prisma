generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Group {
  slug      String   @id
  city      String
  members   Json     @default("[]")
  revision  Int      @default(0)
  run       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kusama_groups")
}
