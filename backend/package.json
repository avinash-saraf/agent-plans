{
  "name": "@agent-plans/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:db": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/postgres.integration.test.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "plan:live": "node --env-file-if-exists=.env scripts/live.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "fastify": "5.6.0",
    "openai": "6.2.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
