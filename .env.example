# Template only — copy to backend/.env and fill in there.
# Never put a real key or password in this file: it is the one env file
# .gitignore deliberately does NOT ignore.

# --- required for a live run (not needed for tests or ?demo=1) ---
OPENROUTER_API_KEY=
EXA_API_KEY=

# --- models (verified against OpenRouter's live /models list) ---
MODEL_CHEAP=openai/gpt-4o-mini
MODEL_STRONG=openai/gpt-4.1

# --- member store: "memory" (default) or "postgres" ---
STORE=memory

# A direct Postgres connection string, not the Supabase project URL.
# Supabase dashboard -> Connect -> Session pooler. URL-encode the password
# (? becomes %3F, # becomes %23) and quote the whole value.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL=

# Set to false only on a network that rewrites TLS certificates.
DATABASE_SSL_STRICT=true

# --- server ---
PORT=8787
CORS_ORIGIN=http://localhost:5173
